# Admin panel — environment namunasi.
# Nusxalash:  cp .env.example .env.development  (yoki .env.production)

# Dev/preview port (vite.config.js shuni o'qiydi)
VITE_DEV_PORT=5177

# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Admin panelning O'Z origin'i va asosiy sayt manzili
VITE_ADMIN_URL=http://localhost:5177
VITE_APP_URL=http://localhost:5173

# Admin backend (admin_backend) API manzili
VITE_API_BASE_URL=http://localhost:8001
