# ============================================================
# FRAGMENTLY-API — Backend Environment (.env.example)
# ============================================================
# Nusxalash:  cp .env.example .env
# So'ng barcha bo'sh qiymatlarni o'zingizning xavfsiz
# ma'lumotlaringiz bilan to'ldiring. .env fayli GITGA
# yuklanmaydi (.gitignore ichida).

# ------------------------------------------------------------
# 1. DATABASE
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/fragmently
# SQLite (local / zero-setup fallback):
# DATABASE_URL=sqlite+aiosqlite:///./fragmently.db

# ------------------------------------------------------------
# 2. SECURITY (JWT + Fernet)
# ------------------------------------------------------------
# Kuchli tasodifiy kalit:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
# HTTPS ishlatilganda cookie'lar secure flag bilan yuboriladi (production: true)
COOKIE_SECURE=false

# Fernet (wallet seed-phrase shifrlash) kaliti. admin_backend/.env bilan BIR XIL bo'lishi shart.
# Yangi kalit:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY_SETTING=

# ------------------------------------------------------------
# 3. REDIS (rate-limit / cache) — OPTIONAL
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120
ENVIRONMENT=development
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------
# 4. TON BLOCKCHAIN
# ------------------------------------------------------------
TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=

# Platforma (komissiya/refund yig'uvchi) hamyoni
PLATFORM_WALLET_ADDRESS=
PLATFORM_SEED_PHRASE=
PLATFORM_ADMIN_WALLET=

# ------------------------------------------------------------
# 5. FRAGMENT.COM (real xaridlar)
# ------------------------------------------------------------
FRAGMENT_API_URL=https://api.fragment.com/v1
FRAGMENT_API_KEY=

# fragment-api-lib (third-party aggregator)
FRAGMENT_API_LIB_URL=https://api.fragment-api.net
FRAGMENT_API_LIB_ENABLED=false

# fragment-stars-api (bbbuilt) — no-KYC TON va USDT (usdt_ton)
FRAGMENT_STARS_API_URL=https://api-fragment.duckdns.org
FRAGMENT_STARS_API_ENABLED=false

# Fragment sessiya cookie'lari (KYC) — maxfiy! Kodga yozmang.
FRAGMENT_COOKIES=
FRAGMENT_COOKIE_SSID=
FRAGMENT_COOKIE_DT=-300
FRAGMENT_COOKIE_TOKEN=
FRAGMENT_COOKIE_TON_TOKEN=

# pyfragment (direct async client — real buy)
PYFRAGMENT_ENABLED=false
PYFRAGMENT_WALLET_VERSION=V5R1
PYFRAGMENT_API_PROVIDER=tonapi
PYFRAGMENT_TIMEOUT=30

# Qo'shimcha Fragment hamyonlari (agar ishlatilsa)
FRAGMENT_STARS_WALLET=
FRAGMENT_PREMIUM_WALLET=

# Fragment narxlari uchun USD anchor
FRAGMENT_STARS_PRICE_USD=0.015
PREMIUM_3M_PRICE_USD=14.99
PREMIUM_6M_PRICE_USD=19.99
PREMIUM_12M_PRICE_USD=35.99
PRICE_CACHE_TTL=60

# ------------------------------------------------------------
# 6. SUBSCRIPTION EXPIRATION (cron)
# ------------------------------------------------------------
EXPIRATION_CHECK_URL=
EXPIRATION_CHECK_SECRET=

# ------------------------------------------------------------
# 7. STRIPE (ixtiyoriy)
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# 8. EMAIL / SMTP (ixtiyoriy)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------
# 9. FRAGMENT BROWSER (Playwright fallback)
# ------------------------------------------------------------
FRAGMENT_HEADLESS=false
FRAGMENT_TIMEOUT=30000

# ------------------------------------------------------------
# 10. ADMIN SEED (birinchi ishga tushirish)
# Format: email:username:full_name:role; ...  (role: superadmin|admin|support)
# ------------------------------------------------------------
SEED_ADMIN_USERS=
