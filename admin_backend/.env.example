# ==========================================================================
# FRAGMENTLY-API ADMIN BACKEND — .env.example
# ==========================================================================
# Nusxalash:  cp .env.example .env
# Har bir qiymatni to'ldiring. .env fayli GITGA yuklanmaydi.

# ------------------------------ Server ------------------------------------
PORT=8001
RATE_LIMIT_PER_MINUTE=120

# ------------------------------ Database ----------------------------------
# ASOSIY backend (backend/.env) bilan BIR XIL baza bo'lishi kerak.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/fragmently

# ------------------------------ JWT Security ------------------------------
# Kuchli tasodifiy kalit:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
# Fernet (seed shifrlash) kaliti — asosiy backend/.env bilan BIR XIL bo'lishi shart.
FERNET_KEY_SETTING=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------ Google OAuth ------------------------------
# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# ------------------------------ Admin ruxsatlar ---------------------------
# "Sign in with Google" orqali faqat shu email(lar) admin bo'la oladi.
# Bir nechta bo'lsa vergul bilan ajrating: a@example.com,b@example.com
ALLOWED_ADMIN_EMAILS=

# IP Whitelist Guard: vergul bilan ajratilgan ruxsat etilgan IP manzillar.
ALLOWED_ADMIN_IPS=127.0.0.1,::1

# ------------------------- Login brute-force himoyasi ----------------------
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_ATTEMPT_WINDOW_SECONDS=300

# ------------------------------ CORS --------------------------------------
# Frontend originlari (JSON massiv). Google Cloud "Authorized JavaScript origins" bilan mos bo'lsin.
ALLOWED_ORIGINS=["http://localhost:5177", "http://127.0.0.1:5177", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174"]

# -------------------- Seed ma'lumotlar (birinchi ishga tushirish) ----------
# Format: email:username:full_name:role; ...  (role: superadmin|admin|support)
SEED_ADMIN_USERS=

# ------------------------------ Telegram ogohlantirish --------------------
SECURITY_ALERT_TELEGRAM_BOT_TOKEN=
SECURITY_ALERT_TELEGRAM_CHAT_ID=
