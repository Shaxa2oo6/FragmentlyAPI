# ============================================================
# FRAGMENTLY — Docker Compose uchun root .env namunasi
# Nusxalash:  cp .env.example .env
# ============================================================

# PostgreSQL
POSTGRES_USER=fragmently
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fragmently

# Backend xavfsizlik
# Kuchli kalit:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
ENVIRONMENT=development

# Frontend (build vaqtida ishlatiladi)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_API_BASE_URL=http://localhost:8000
