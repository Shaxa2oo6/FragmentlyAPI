# Asosiy ilova — frontend environment namunasi.
# Nusxalash:  cp .env.example .env  (development uchun: cp .env.example .env.development)

# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Platforma / API manzillari
VITE_APP_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_TELEGRAM_SUPPORT_URL=https://t.me/your_support

# Kontakt ma'lumotlari
VITE_CONTACT_TELEGRAM=@your_support
VITE_CONTACT_EMAIL=support@example.com
VITE_CONTACT_TELEGRAM_CHANNEL=@your_channel
